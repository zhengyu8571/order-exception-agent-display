flowchart TB
    accTitle: OrderFlow 独立订单模拟服务模块架构
CLIENT["🔌 OrderTools / HTTP 调用方"]
    subgraph CORE["订单模拟服务 · FastAPI :8101"]
        API["api.py<br/>服务令牌与请求契约"]
